{
  "name": "1a2b-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.ts",
    "dev": "npm run build && wrangler dev --local",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:http": "node scripts/smoke-solo.ts",
    "test:browser": "node scripts/browser-qa.mjs",
    "build:check": "npm run build && wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "solver:table": "node scripts/generate-opening-table.ts",
    "solver:table:check": "node scripts/generate-opening-table.ts --check",
    "solver:benchmark": "node scripts/benchmark-solver.ts",
    "check": "npm run typecheck && npm test && npm run solver:table:check && npm run test:runtime"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
