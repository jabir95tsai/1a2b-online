{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "1a2b-online",
  "workers_dev": true,
  "preview_urls": false,
  "main": "src/server/index.ts",
  "assets": { "directory": "dist/client", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SOLO_GAMES", "class_name": "SoloGame" },
      { "name": "GAME_ROOMS", "class_name": "GameRoom" }
    ]
  },
  "exports": {
    "SoloGame": { "type": "durable-object", "storage": "sqlite" },
    "GameRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "ratelimits": [
    { "name": "SESSION_LIMIT", "namespace_id": "12001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "12002", "simple": { "limit": 10, "period": 60 } },
    { "name": "ACTION_LIMIT", "namespace_id": "12003", "simple": { "limit": 120, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "12004", "simple": { "limit": 5, "period": 60 } },
    { "name": "JOIN_IP_LIMIT", "namespace_id": "12005", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": { "REVEAL_OPPONENT_HISTORY": "false" },
  "observability": { "enabled": false },
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "http" }
}
